    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "jose": "^6.2.2",
    "@cindy/device-link-relay": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
