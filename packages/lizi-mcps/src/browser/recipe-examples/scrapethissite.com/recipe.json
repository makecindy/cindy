{
  "id": "hockey-search",
  "match": [
    "scrapethissite.com"
  ],
  "description": "在 scrapethissite forms 页搜索球队并抽取结果(演示交互步:输入+回车提交)。示例配方。",
  "inputs": {
    "query": {
      "required": true
    }
  },
  "steps": [
    {
      "action": "navigate",
      "url": "https://www.scrapethissite.com/pages/forms/"
    },
    {
      "action": "type",
      "selector": "input[name=q]",
      "value": "{{query}}",
      "submit": true
    },
    {
      "action": "wait",
      "loadState": "load"
    },
    {
      "action": "extract",
      "as": "teams",
      "extract": {
        "from": "tr.team",
        "multiple": true,
        "fields": {
          "name": ".name",
          "wins": ".wins",
          "losses": ".losses"
        }
      }
    }
  ],
  "output": "{{teams}}",
  "access": "read"
}
