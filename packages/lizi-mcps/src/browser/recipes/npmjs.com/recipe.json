{
  "id": "npm-search",
  "match": [
    "npmjs.com",
    "registry.npmjs.org"
  ],
  "description": "Search the public npm registry by keyword",
  "access": "read",
  "adapter": "npm/search",
  "inputs": {
    "query": {
      "required": true,
      "type": "str",
      "description": "Search keyword (e.g. \"react\", \"graphql client\")"
    },
    "limit": {
      "required": false,
      "type": "int",
      "default": 20,
      "description": "Max results (1-250)"
    }
  },
  "steps": []
}
