{
  "id": "bluesky-user-posts",
  "match": [
    "bsky.app"
  ],
  "description": "Get recent posts from a Bluesky user",
  "access": "read",
  "adapter": "bluesky/user",
  "adapterInputMap": {
    "username": "handle"
  },
  "inputs": {
    "username": {
      "required": true,
      "type": "str",
      "description": "Bluesky handle (e.g. bsky.app)"
    },
    "limit": {
      "required": false,
      "type": "int",
      "default": 20,
      "description": "Number of posts"
    }
  },
  "steps": []
}
