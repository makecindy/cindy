{
  "id": "crates-search",
  "match": [
    "crates.io"
  ],
  "description": "Search the public crates.io registry by keyword",
  "access": "read",
  "adapter": "crates/search",
  "inputs": {
    "query": {
      "required": true,
      "type": "str",
      "description": "Search keyword (e.g. \"serde\", \"async runtime\")"
    },
    "limit": {
      "required": false,
      "type": "int",
      "default": 20,
      "description": "Max results (1-100)"
    }
  },
  "steps": []
}
