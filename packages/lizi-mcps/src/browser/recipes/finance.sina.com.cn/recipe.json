{
  "id": "sinafinance-news",
  "match": [
    "finance.sina.com.cn",
    "app.cj.sina.com.cn"
  ],
  "description": "新浪财经 7x24 小时实时快讯",
  "access": "read",
  "adapter": "sinafinance/news",
  "inputs": {
    "limit": {
      "required": false,
      "type": "int",
      "default": 20,
      "description": "Max results (max 50)"
    },
    "type": {
      "required": false,
      "type": "int",
      "default": 0,
      "description": "News type: 0=全部 1=A股 2=宏观 3=公司 4=数据 5=市场 6=国际 7=观点 8=央行 9=其它"
    }
  },
  "steps": []
}
