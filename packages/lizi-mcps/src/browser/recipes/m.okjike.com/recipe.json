{
  "id": "jike-user-posts",
  "match": [
    "m.okjike.com",
    "okjike.com"
  ],
  "description": "即刻用户动态",
  "access": "read",
  "adapter": "jike/user",
  "inputs": {
    "username": {
      "required": true,
      "type": "string",
      "description": "Username from profile URL (e.g. wenhao1996)"
    },
    "limit": {
      "required": false,
      "type": "int",
      "default": 20,
      "description": "Number of posts"
    }
  },
  "steps": []
}
