{
  "id": "hn-search",
  "match": [
    "news.ycombinator.com",
    "hn.algolia.com"
  ],
  "description": "Search Hacker News stories",
  "access": "read",
  "adapter": "hackernews/search",
  "inputs": {
    "query": {
      "required": true,
      "type": "str",
      "description": "Search query"
    },
    "limit": {
      "required": false,
      "type": "int",
      "default": 20,
      "description": "Number of results"
    },
    "sort": {
      "required": false,
      "type": "str",
      "default": "relevance",
      "description": "Sort by relevance or date",
      "choices": [
        "relevance",
        "date"
      ]
    }
  },
  "steps": []
}
