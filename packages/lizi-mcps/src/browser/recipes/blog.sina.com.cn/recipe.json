{
  "id": "sinablog-search",
  "match": [
    "blog.sina.com.cn",
    "search.sina.com.cn"
  ],
  "description": "搜索新浪博客文章（通过新浪搜索）",
  "access": "read",
  "adapter": "sinablog/search",
  "adapterInputMap": {
    "query": "keyword"
  },
  "inputs": {
    "query": {
      "required": true,
      "type": "str",
      "description": "搜索关键词"
    },
    "limit": {
      "required": false,
      "type": "int",
      "default": 20,
      "description": "返回的文章数量"
    }
  },
  "steps": []
}
