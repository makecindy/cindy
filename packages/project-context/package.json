{
  "name": "project-context",
  "version": "0.0.0",
  "description": "Agent-maintained project knowledge layer (commit-driven, markdown + frontmatter, generic CLI)",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "project-context": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "chalk": "^5.4.0",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "gray-matter": "^4.0.3",
    "ignore": "^5.3.2",
    "js-yaml": "^4.1.0",
    "micromatch": "^4.0.8",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/cross-spawn": "^6.0.6",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "typescript-eslint": "^8.0.0"
  }
}
