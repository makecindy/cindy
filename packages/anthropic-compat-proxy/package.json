{
  "name": "@cindy/anthropic-compat-proxy",
  "version": "0.0.0",
  "private": true,
  "description": "Loopback HTTP proxy that strips Anthropic-only request fields when the target model is non-Anthropic. Lets Claude Code SDK talk to gateways routing to OpenAI/Azure/etc backends.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "node build.mjs",
    "lint": "eslint src/"
  },
  "author": {
    "name": "X.D. Network Inc.",
    "email": "feedback@cindy.app"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "*",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "selfsigned": "^5.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
