{
  "name": "@cindy/maker-core",
  "version": "0.0.0",
  "private": true,
  "description": "Cindy core: agent abstractions, session orchestration, zero Electron deps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./customization-scanner": "./src/agents/shared/customization-worker-api.ts",
    "./pi-extension-ui": "./src/agents/pi/extension-ui-capabilities.ts",
    "./pi-subagent-runs": "./src/agents/pi/pi-subagent-runs.ts",
    "./skill-scan-limits": "./src/agents/shared/skill-scan-limits.ts",
    "./runtime-owner-lock": {
      "types": "./src/runtime-owner-lock.d.ts",
      "import": "./src/runtime-owner-lock.js",
      "default": "./src/runtime-owner-lock.js"
    },
    "./claude-cli-login-status": {
      "import": "./src/agents/claude-code/cli-login-status.ts",
      "default": "./src/agents/claude-code/cli-login-status.ts"
    },
    "./agents/claude-code": {
      "import": "./src/agents/claude-code/index.ts",
      "default": "./src/agents/claude-code/index.ts"
    },
    "./maker": {
      "import": "./src/maker.ts",
      "default": "./src/maker.ts"
    },
    "./agents/codex": {
      "import": "./src/agents/codex/index.ts",
      "default": "./src/agents/codex/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "author": {
    "name": "XD Inc.",
    "email": "feedback@cindy.app"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "@anthropic-ai/sdk": "^0.93.0",
    "@cindy/maker-shared": "workspace:*",
    "@cindy/model-providers": "workspace:*",
    "diff": "^8.0.4",
    "gray-matter": "^4.0.3"
  },
  "peerDependencies": {
    "better-sqlite3": "*",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
