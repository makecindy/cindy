{
  "name": "@cindy/device-link",
  "version": "0.0.0",
  "private": true,
  "description": "跨设备远程控制(同账号设备互联)的协议层 + WS 客户端: envelope 协议、IPC 隧道 allowlist、DeviceLinkClient(重连/心跳/请求配对)。零依赖、Electron-agnostic,WebSocket 实现由 host 注入。",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run"
  },
  "author": {
    "name": "XD Inc.",
    "email": "feedback@cindy.app"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@cindy/device-link-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
