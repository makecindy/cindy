# EAS iOS builds for apps/mobile run from the monorepo root. Keep the
# archive focused on the mobile app plus the shared packages Metro imports.

.git
.DS_Store
.expo
node_modules
**/node_modules
**/.env
**/.env.*
!.env.example
!apps/mobile/.env.example

.agents
.claude
# 项目元数据目录（带斜杠限定目录，避免误伤 *.cindy ghost 包文件）
.cindy/
docs
!docs/
docs/*
!docs/legal/
docs/legal/*
!docs/legal/notices/
docs/legal/notices/*
!docs/legal/notices/mobile-ios.txt
!docs/legal/notices/mobile-ios-restricted.txt
!docs/legal/notices/mobile-android.txt
!docs/legal/notices/mobile-android-restricted.txt
scripts/*
!scripts/ensure-agent-binaries.mjs
!scripts/agent-binary-cdn-fallback.mjs
!scripts/fix-node-pty-perms.mjs
# app.config.js 在 EAS 云端求值时同步读取 region 端点清单的构建适配器。
!scripts/shared
!scripts/shared/client-endpoint-build-env.cjs
.gitlab-ci*

apps/*
!apps/mobile
!apps/mobile/**
apps/mobile/.expo
apps/mobile/ios
apps/mobile/android
apps/mobile/e2e
apps/mobile/docs
apps/mobile/visual-*.png

packages/*
!packages/auth-client
!packages/auth-client/**
!packages/device-link
!packages/device-link/**
!packages/device-link-protocol
!packages/device-link-protocol/**
!packages/maker-shared
!packages/maker-shared/**
!packages/model-providers
!packages/model-providers/**
!packages/voice-input-core
!packages/voice-input-core/**

tools/*
!tools/shared
!tools/shared/fetch-with-timeout.mjs
