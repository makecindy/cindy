*.sh text eol=lf
# .mjs 脚本大多带 #!/usr/bin/env node shebang:Windows autocrlf 检出成 CRLF 后,
# vitest(vite 转换链)加载「CRLF + shebang」组合会直接 SyntaxError,unix 下直接执行也会坏,
# 与 *.sh 同理固定 LF 检出。
*.mjs text eol=lf
# git hook 没有扩展名，命不中上面两条。Windows autocrlf 检出成 CRLF 后 `#!/bin/sh\r`
# 无法执行，git commit 会直接 `fatal: cannot exec`——装了 hook 的人从此提交不了。
.githooks/** text eol=lf
# SQLite migration 内容参与用户数据库 drift hash；跨平台统一 LF。
apps/desktop/drizzle/**/*.sql text eol=lf
# sqlite-vec 扩展二进制（平台特定 .dylib / .dll）—— 走 Git LFS
apps/desktop/native/sqlite-vec/**/*.dylib filter=lfs diff=lfs merge=lfs -text
apps/desktop/native/sqlite-vec/**/*.dll filter=lfs diff=lfs merge=lfs -text
apps/desktop/native/sqlite-vec/**/*.so filter=lfs diff=lfs merge=lfs -text
# claude / codex / ripgrep CLI 二进制不再进 git/LFS——按需从上游下载
# （见 scripts/ensure-agent-binaries.mjs；版本 pin 在 tools/<kind>/latest.json）。
# Android platform-tools 二进制—— 走 Git LFS
apps/android-platform-tools-bin/**/*.exe filter=lfs diff=lfs merge=lfs -text
apps/android-platform-tools-bin/**/*.dll filter=lfs diff=lfs merge=lfs -text
apps/desktop/resources/cindy-updater.exe filter=lfs diff=lfs merge=lfs -text
# Pencil 设计稿（加密二进制，体积大且改动频繁）—— 走 Git LFS
*.pen filter=lfs diff=lfs merge=lfs -text
# Vendored browser-control-runtime：由 scripts/browser-runtime/sync.mjs 从上游同步生成，非手写源码。
# 标记为 generated，让 GitHub 在 PR diff 中默认折叠、排除出仓库语言统计，避免淹没 reviewer。
packages/browser-control-runtime/src/_generated/** linguist-generated=true

# ── 开源公开仓排除(内部专用,不进对外发布)────────────────────────────
# export-ignore 让 `git archive` 导出时自动剔除;若以「复制工作树 + git init」方式建
# 公开仓,则在新仓首次提交前排除服务端桥接和官方发布链路。
apps/mobile/scripts/release-*.mjs export-ignore
apps/mobile/scripts/release-*.sh export-ignore
apps/mobile/scripts/promote-*.mjs export-ignore
