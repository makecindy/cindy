new file mode 100644
index 0000000..5437df1
--- /dev/null
+++ b/packages/coding-agent/test/rpc-client-runtime-refresh.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it, vi } from "vitest";
+import { RpcClient } from "../src/modes/rpc/rpc-client.ts";
+
+type ClientTransport = {
+	send: (command: { type: string; reserveTokens?: number | null }) => Promise<unknown>;
+	getData: <T>(response: unknown) => T;
+};
+
+describe("RpcClient runtime refresh", () => {
+	it("uses the public refresh and live compaction commands", async () => {
+		const client = new RpcClient();
+		const transport = client as unknown as ClientTransport;
+		const send = vi.fn(async (command: { type: string; reserveTokens?: number | null }) => ({
+			data:
+				command.type === "refresh_models"
+					? { models: [], aborted: false, errors: {} }
+					: { reserveTokens: command.reserveTokens === null ? 16384 : command.reserveTokens },
+		}));
+		transport.send = send;
+		transport.getData = <T>(response: unknown): T => (response as { data: T }).data;
+
+		expect(await client.refreshModels()).toEqual({ models: [], aborted: false, errors: {} });
+		expect(await client.setCompactionReserveTokens(32000)).toBe(32000);
+		expect(await client.setCompactionReserveTokens(null)).toBe(16384);
+		expect(send.mock.calls.map(([command]) => command)).toEqual([
+			{ type: "refresh_models" },
+			{ type: "set_compaction_reserve_tokens", reserveTokens: 32000 },
+			{ type: "set_compaction_reserve_tokens", reserveTokens: null },
+		]);
+	});
+});
