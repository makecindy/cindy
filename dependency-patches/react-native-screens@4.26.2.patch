+// Cindy patch: identity of a bar button (plain button or menu) is its whole config except the
+// menu. Every item of the toolbar must be reusable: one freshly allocated sibling makes the
+// header reassign the whole item array, which dismisses an open menu. Press handlers route
+// through the owning header config, so a reused button keeps working.
+static NSDictionary *RNSBarButtonReuseKey(NSDictionary *dict)
+{
+  if (dict[@"menu"] == nil && dict[@"buttonId"] == nil) {
+    return nil;
+  }
+  NSMutableDictionary *key = [dict mutableCopy];
+  [key removeObjectForKey:@"menu"];
+  return key;
+}
+
+// Cindy patch: shape of a menu config without the values a toggle changes (checkmark,
+// subtitle, disabled). Equal shapes let a menu be updated in place instead of replaced:
+// replacing an open menu pops it back to its root, so a checkmark inside a submenu would
+// collapse the submenu.
+static id RNSMenuShapeKey(id value)
+{
+  if ([value isKindOfClass:[NSDictionary class]]) {
+    NSMutableDictionary *shape = [NSMutableDictionary new];
+    [(NSDictionary *)value enumerateKeysAndObjectsUsingBlock:^(id key, id obj, BOOL *stop) {
+      if ([key isEqual:@"state"] || [key isEqual:@"subtitle"] || [key isEqual:@"disabled"]) {
+        return;
+      }
+      shape[key] = RNSMenuShapeKey(obj);
+    }];
+    return shape;
+  }
+  if ([value isKindOfClass:[NSArray class]]) {
+    NSMutableArray *shape = [NSMutableArray new];
+    for (id obj in (NSArray *)value) {
+      [shape addObject:RNSMenuShapeKey(obj)];
+    }
+    return shape;
+  }
+  return value ?: [NSNull null];
+}
+
+static UIMenuElementState RNSMenuElementStateFromConfig(NSDictionary *dict)
+{
+  NSString *state = dict[@"state"];
+  if ([state isEqualToString:@"on"]) {
+    return UIMenuElementStateOn;
+  }
+  if ([state isEqualToString:@"mixed"]) {
+    return UIMenuElementStateMixed;
+  }
+  return UIMenuElementStateOff;
+}
