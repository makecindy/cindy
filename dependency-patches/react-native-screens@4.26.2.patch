+/// Collects the values applyValuesFromMenuConfig writes (check state, disabled flag, subtitles),
+/// keyed by action identifier (menuId) and submenu title.
+static void RNSCollectMenuValues(UIMenu *menu, NSMutableDictionary<NSString *, UIAction *> *actions, NSMutableDictionary *subtitles)
+{
+  for (UIMenuElement *child in menu.children) {
+    if ([child isKindOfClass:[UIAction class]]) {
+      NSString *identifier = ((UIAction *)child).identifier;
+      if (identifier.length > 0) {
+        actions[identifier] = (UIAction *)child;
+      }
+    } else if ([child isKindOfClass:[UIMenu class]]) {
+      UIMenu *submenu = (UIMenu *)child;
+      if (submenu.title.length > 0) {
+        if (@available(iOS 15.0, *)) {
+          subtitles[submenu.title] = submenu.subtitle ?: (id)[NSNull null];
+        }
+      }
+      RNSCollectMenuValues(submenu, actions, subtitles);
+    }
+  }
+}
+
+static BOOL RNSActionValuesEqual(UIAction *a, UIAction *b)
+{
+  if (a.state != b.state || a.attributes != b.attributes) {
+    return NO;
+  }
+  if (@available(iOS 15.0, *)) {
+    return a.subtitle == b.subtitle || [a.subtitle isEqualToString:b.subtitle];
+  }
+  return YES;
+}
+
+/// Returns a copy of `menu` carrying the source values. updateVisibleMenu only redraws when the
+/// block hands back new elements, so changed actions are copied rather than mutated in place.
+static UIMenu *RNSMenuWithValues(UIMenu *menu, NSDictionary<NSString *, UIAction *> *actions, NSDictionary *subtitles)
+{
+  NSMutableArray<UIMenuElement *> *children = [NSMutableArray arrayWithCapacity:menu.children.count];
+  for (UIMenuElement *child in menu.children) {
+    if ([child isKindOfClass:[UIAction class]]) {
+      UIAction *action = (UIAction *)child;
+      UIAction *source = actions[action.identifier ?: @""];
+      if (source != nil && !RNSActionValuesEqual(action, source)) {
+        UIAction *copy = [action copy];
+        copy.state = source.state;
+        copy.attributes = source.attributes;
+        if (@available(iOS 15.0, *)) {
+          copy.subtitle = source.subtitle;
+        }
+        [children addObject:copy];
+      } else {
+        [children addObject:action];
+      }
+    } else if ([child isKindOfClass:[UIMenu class]]) {
+      [children addObject:RNSMenuWithValues((UIMenu *)child, actions, subtitles)];
+    } else {
+      [children addObject:child];
+    }
+  }
+  UIMenu *result = [menu menuByReplacingChildren:children];
+  id subtitle = menu.title.length > 0 ? subtitles[menu.title] : nil;
+  if (subtitle != nil) {
+    if (@available(iOS 15.0, *)) {
+      result.subtitle = subtitle == [NSNull null] ? nil : subtitle;
+    }
+  }
+  return result;
+}
+
+static void RNSCollectContextMenuInteractions(UIView *view, NSMutableArray<UIContextMenuInteraction *> *out)
+{
+  for (id<UIInteraction> interaction in view.interactions) {
+    if ([interaction isKindOfClass:[UIContextMenuInteraction class]]) {
+      [out addObject:(UIContextMenuInteraction *)interaction];
+    }
+  }
+  for (UIView *subview in view.subviews) {
+    RNSCollectContextMenuInteractions(subview, out);
+  }
+}
+
+/// UIKit renders a copy of an open menu, so in-place writes to our UIMenu do not show until
+/// it is reopened. Push the values (checkmarks, disabled flags, subtitles) into whichever menu is currently on screen through the
+/// public updateVisibleMenu API (a no-op for interactions whose menu is not open). Actions
+/// are matched by identifier (menuId), submenus by title.
++ (void)rns_refreshVisibleMenusWithSource:(UIMenu *)source
+{
+  if (@available(iOS 16.0, *)) {
+    NSMutableDictionary<NSString *, UIAction *> *actions = [NSMutableDictionary new];
+    NSMutableDictionary *subtitles = [NSMutableDictionary new];
+    RNSCollectMenuValues(source, actions, subtitles);
+    if (actions.count == 0 && subtitles.count == 0) {
+      return;
+    }
+    NSMutableArray<UIContextMenuInteraction *> *interactions = [NSMutableArray new];
+    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+      if (![scene isKindOfClass:[UIWindowScene class]]) {
+        continue;
+      }
+      for (UIWindow *window in ((UIWindowScene *)scene).windows) {
+        RNSCollectContextMenuInteractions(window, interactions);
+      }
+    }
+    for (UIContextMenuInteraction *interaction in interactions) {
+      [interaction updateVisibleMenuWithBlock:^UIMenu *_Nonnull(UIMenu *_Nonnull visibleMenu) {
+        return RNSMenuWithValues(visibleMenu, actions, subtitles);
+      }];
+    }
+  }
+}
