+/// Writes checkmarks, subtitles and the disabled flag into an existing menu tree whose
+/// shape matches the config (children are created in config order).
++ (void)applyValuesFromMenuConfig:(NSDictionary *)dict toMenu:(UIMenu *)menu
+{
+  if (@available(iOS 15.0, *)) {
+    menu.subtitle = dict[@"subtitle"];
+  }
+  NSArray *items = dict[@"items"];
+  NSArray<UIMenuElement *> *children = menu.children;
+  if (items.count != children.count) {
+    return;
+  }
+  for (NSUInteger i = 0; i < items.count; i++) {
+    NSDictionary *item = items[i];
+    UIMenuElement *child = children[i];
+    if (item[@"menuId"] != nil && [child isKindOfClass:[UIAction class]]) {
+      UIAction *action = (UIAction *)child;
+      action.state = RNSMenuElementStateFromConfig(item);
+      if (@available(iOS 15.0, *)) {
+        action.subtitle = item[@"subtitle"];
+      }
+      if ([item[@"disabled"] boolValue]) {
+        action.attributes |= UIMenuElementAttributesDisabled;
+      } else {
+        action.attributes &= ~UIMenuElementAttributesDisabled;
+      }
+    } else if ([child isKindOfClass:[UIMenu class]]) {
+      [self applyValuesFromMenuConfig:item toMenu:(UIMenu *)child];
+    }
+  }
+}
