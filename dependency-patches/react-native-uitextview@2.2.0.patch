+// 触点是否贴近选区两端(=手柄位置)。普通滚动/点按不从手柄起步,不会误入护航模式。
+- (BOOL)isPoint:(CGPoint)point nearSelectionEdge:(NSRange)range
+{
+  UITextPosition *startPos = [_textView positionFromPosition:_textView.beginningOfDocument
+                                                      offset:(NSInteger)range.location];
+  UITextPosition *endPos = [_textView positionFromPosition:_textView.beginningOfDocument
+                                                    offset:(NSInteger)NSMaxRange(range)];
+  const CGFloat threshold = 44.0;
+  for (UITextPosition *pos in @[startPos ?: (UITextPosition *)NSNull.null,
+                                endPos ?: (UITextPosition *)NSNull.null]) {
+    if ([pos isKindOfClass:NSNull.class]) {
+      continue;
+    }
+    const CGRect caret = [_textView caretRectForPosition:(UITextPosition *)pos];
+    if (CGRectIsNull(caret) || CGRectIsInfinite(caret)) {
+      continue;
+    }
+    const CGRect hitArea = CGRectInset(caret, -threshold, -threshold);
+    if (CGRectContainsPoint(hitArea, point)) {
+      return YES;
+    }
+  }
+  return NO;
+}
+
+// 手指在外层滚动视图可视区边缘 → 连续平滑滚动(速度随贴边深度加速)。
+- (void)autoScrollForTouchAtWindowPoint:(CGPoint)touchInWindow
+{
+  UIScrollView *scrollView = [self enclosingScrollView];
+  if (scrollView == nil) {
+    return;
+  }
+  const CGPoint touchInScroll = [scrollView convertPoint:touchInWindow fromView:nil];
+  const UIEdgeInsets inset = scrollView.adjustedContentInset;
+  const CGFloat visibleTop = scrollView.contentOffset.y + inset.top;
+  const CGFloat visibleBottom = scrollView.contentOffset.y + scrollView.bounds.size.height - inset.bottom;
+  const CGFloat topEdge = 88.0;
+  // 底部放宽:半透明 composer 悬浮在列表底部,insets 不描述它。
+  const CGFloat bottomEdge = 160.0;
+  const CGFloat maxStepPerFrame = 10.0;
+
+  CGFloat step = 0;
+  if (touchInScroll.y > visibleBottom - bottomEdge) {
+    const CGFloat depth = MIN(1.0, (touchInScroll.y - (visibleBottom - bottomEdge)) / bottomEdge);
+    step = maxStepPerFrame * depth;
+  } else if (touchInScroll.y < visibleTop + topEdge) {
+    const CGFloat depth = MIN(1.0, ((visibleTop + topEdge) - touchInScroll.y) / topEdge);
+    step = -maxStepPerFrame * depth;
+  }
+  if (step == 0) {
+    return;
+  }
+  const CGFloat minOffset = -inset.top;
+  const CGFloat maxOffset = MAX(minOffset,
+      scrollView.contentSize.height + inset.bottom - scrollView.bounds.size.height);
+  CGFloat target = scrollView.contentOffset.y + step;
+  target = MIN(MAX(target, minOffset), maxOffset);
+  if (fabs(target - scrollView.contentOffset.y) < 0.1) {
+    return;
+  }
+  [scrollView setContentOffset:CGPointMake(scrollView.contentOffset.x, target) animated:NO];
+}
+
+- (UIScrollView *)enclosingScrollView
+{
+  UIView *ancestor = self.superview;
+  while (ancestor != nil) {
+    if ([ancestor isKindOfClass:UIScrollView.class]) {
+      UIScrollView *candidate = (UIScrollView *)ancestor;
+      if (candidate.scrollEnabled &&
+          candidate.contentSize.height > candidate.bounds.size.height + 1) {
+        return candidate;
+      }
+    }
+    ancestor = ancestor.superview;
+  }
+  return nil;
 }
 
