+- (void)ensureSelectionDisplayLink
+{
+  if (_selectionDisplayLink != nil) {
+    return;
+  }
+  _selectionDisplayLink = [CADisplayLink displayLinkWithTarget:self
+                                                      selector:@selector(selectionDisplayLinkTick:)];
+  [_selectionDisplayLink addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
+  os_log_debug(OS_LOG_DEFAULT, "[RNUITextView-sel] tag=%ld displaylink armed", (long)self.tag);
+}
+
+- (void)invalidateSelectionDisplayLink
+{
+  if (_selectionDisplayLink == nil) {
+    return;
+  }
+  [_selectionDisplayLink invalidate];
+  _selectionDisplayLink = nil;
+  _lastSelectionRange = NSMakeRange(NSNotFound, 0);
+  _selectionEdgeDragActive = NO;
+  [self notifySelectionDragEnded];
+  os_log_debug(OS_LOG_DEFAULT, "[RNUITextView-sel] tag=%ld displaylink disarmed", (long)self.tag);
+}
+
+// Route the handle-drag lifecycle through the enclosing scroll view's user-drag
+// delegate path (review P2): the auto-scroll below moves contentOffset directly,
+// which never fires JS onScrollBeginDrag — the path where the list owner releases
+// bottom-stickiness. Without this, a streaming content growth during an active
+// selection would treat the list as still stuck-to-bottom and yank the viewport
+// back down, disrupting the selection. Calling the delegate methods makes JS see
+// exactly what a finger drag emits; no new native->JS API surface is needed.
+- (void)notifySelectionDragBegan
+{
+  UIScrollView *scrollView = [self enclosingScrollView];
+  if (scrollView == nil) {
+    return;
+  }
+  _selectionDragScrollView = scrollView;
+  id<UIScrollViewDelegate> delegate = scrollView.delegate;
+  if ([delegate respondsToSelector:@selector(scrollViewWillBeginDragging:)]) {
+    [delegate scrollViewWillBeginDragging:scrollView];
+  }
+}
+
+- (void)notifySelectionDragEnded
+{
+  UIScrollView *scrollView = _selectionDragScrollView;
+  _selectionDragScrollView = nil;
+  if (scrollView == nil) {
+    return;
+  }
+  id<UIScrollViewDelegate> delegate = scrollView.delegate;
+  if ([delegate respondsToSelector:@selector(scrollViewDidEndDragging:willDecelerate:)]) {
+    [delegate scrollViewDidEndDragging:scrollView willDecelerate:NO];
+  }
+}
