+// MARK: - Custom edit menu action (chat-text-quote)
+
+// Inserts a custom action (menuActionLabel prop) in FRONT of the system edit
+// menu items (Copy / Look Up / ...) shown for a text selection. Emits
+// onMenuAction with the selected range at tap time, then clears the selection
+// (deferred past menu dismissal). iOS 16+ only; earlier systems keep the plain
+// system menu.
+- (UIMenu *)textView:(UITextView *)textView
+  editMenuForTextInRange:(NSRange)range
+        suggestedActions:(NSArray<UIMenuElement *> *)suggestedActions API_AVAILABLE(ios(16.0))
+{
+  if (range.length == 0) {
+    return [UIMenu menuWithChildren:suggestedActions];
+  }
+  __weak RNUITextView *weakSelf = self;
+  void (^performAction)(BOOL) = ^(BOOL sideChat) {
+    RNUITextView *strongSelf = weakSelf;
+    if (strongSelf == nil || strongSelf->_eventEmitter == nullptr) {
+      return;
+    }
+    // Use the live range after any handle adjustment, not the menu's original range.
+    const NSRange selection = strongSelf->_textView.selectedRange;
+    if (selection.location == NSNotFound || selection.length == 0 ||
+        NSMaxRange(selection) > strongSelf->_textView.text.length) {
+      return;
+    }
+    auto emitter = std::dynamic_pointer_cast<const facebook::react::RNUITextViewEventEmitter>(strongSelf->_eventEmitter);
+    if (sideChat) {
+      emitter->onSideChatMenuAction(facebook::react::RNUITextViewEventEmitter::OnSideChatMenuAction{
+        static_cast<int>(strongSelf.tag),
+        static_cast<int>(selection.location),
+        static_cast<int>(NSMaxRange(selection)),
+      });
+    } else {
+      emitter->onMenuAction(facebook::react::RNUITextViewEventEmitter::OnMenuAction{
+        static_cast<int>(strongSelf.tag),
+        static_cast<int>(selection.location),
+        static_cast<int>(NSMaxRange(selection)),
+      });
+    }
+    // Clear after dismissal so the system teardown never races a selection mutation.
+    UITextView *innerTextView = strongSelf->_textView;
+    dispatch_async(dispatch_get_main_queue(), ^{
+      innerTextView.selectedTextRange = nil;
+      [weakSelf syncOutsideTapRecognizer];
+    });
+  };
+  NSMutableArray<UIMenuElement *> *children = [NSMutableArray array];
+  if (_menuActionLabel.length > 0) {
+    [children addObject:[UIAction actionWithTitle:_menuActionLabel image:nil identifier:nil
+      handler:^(__kindof UIAction *action) { performAction(NO); }]];
+  }
+  if (_sideChatMenuActionLabel.length > 0) {
+    [children addObject:[UIAction actionWithTitle:_sideChatMenuActionLabel image:nil identifier:nil
+      handler:^(__kindof UIAction *action) { performAction(YES); }]];
