+// 触点是否贴近选区两端(=手柄位置)。普通滚动/点按不从手柄起步,不会误入护航模式。
+- (BOOL)isPoint:(CGPoint)point nearSelectionEdge:(NSRange)range
+{
+  UITextPosition *startPos = [_textView positionFromPosition:_textView.beginningOfDocument
+                                                      offset:(NSInteger)range.location];
+  UITextPosition *endPos = [_textView positionFromPosition:_textView.beginningOfDocument
+                                                    offset:(NSInteger)NSMaxRange(range)];
+  const CGFloat threshold = 44.0;
+  for (UITextPosition *pos in @[startPos ?: (UITextPosition *)NSNull.null,
+                                endPos ?: (UITextPosition *)NSNull.null]) {
+    if ([pos isKindOfClass:NSNull.class]) {
+      continue;
+    }
+    const CGRect caret = [_textView caretRectForPosition:(UITextPosition *)pos];
+    if (CGRectIsNull(caret) || CGRectIsInfinite(caret)) {
+      continue;
+    }
+    const CGRect hitArea = CGRectInset(caret, -threshold, -threshold);
+    if (CGRectContainsPoint(hitArea, point)) {
+      return YES;
+    }
+  }
+  return NO;
+}
