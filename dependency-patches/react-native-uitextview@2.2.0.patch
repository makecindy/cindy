+- (void)selectionDisplayLinkTick:(CADisplayLink *)link
+{
+  // 护航模式生命周期:视图离屏 / 手指抬起即停(tick 内自检,兼作 CADisplayLink 持有 self 的释放出口)。
+  if (self.window == nil || _textView.window == nil || !_selectionEdgeDragActive) {
+    [self invalidateSelectionDisplayLink];
+    return;
+  }
+  [self autoScrollForTouchAtWindowPoint:_selectionTouchInWindow];
+}
