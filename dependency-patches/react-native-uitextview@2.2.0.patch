+- (void)handleSelectionTouchObserver:(UILongPressGestureRecognizer *)sender
+{
+  switch (sender.state) {
+    case UIGestureRecognizerStateBegan: {
+      const NSRange range = _textView.selectedRange;
+      if (range.length == 0 || range.location == NSNotFound) {
+        return;
+      }
+      const CGPoint location = [sender locationInView:_textView];
+      if (![self isPoint:location nearSelectionEdge:range]) {
+        return;
+      }
+      _selectionEdgeDragActive = YES;
+      _selectionTouchInWindow = [sender locationInView:nil];
+      os_log_debug(OS_LOG_DEFAULT, "[RNUITextView-sel] tag=%ld edge-drag engaged", (long)self.tag);
+      [self ensureSelectionDisplayLink];
+      [self notifySelectionDragBegan];
+      break;
+    }
+    case UIGestureRecognizerStateChanged:
+      if (_selectionEdgeDragActive) {
+        _selectionTouchInWindow = [sender locationInView:nil];
+      }
+      break;
+    default:
+      if (_selectionEdgeDragActive) {
+        os_log_debug(OS_LOG_DEFAULT, "[RNUITextView-sel] tag=%ld edge-drag released", (long)self.tag);
+      }
+      _selectionEdgeDragActive = NO;
+      [self notifySelectionDragEnded];
+      break;
+  }
