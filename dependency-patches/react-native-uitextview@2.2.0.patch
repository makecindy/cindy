+// MARK: - Custom edit menu action (chat-text-quote)
+
+// Inserts a custom action (menuActionLabel prop) in FRONT of the system edit
+// menu items (Copy / Look Up / ...) shown for a text selection. Emits
+// onMenuAction with the selected range at tap time, then clears the selection
+// (deferred past menu dismissal). iOS 16+ only; earlier systems keep the plain
+// system menu.
+- (UIMenu *)textView:(UITextView *)textView
+  editMenuForTextInRange:(NSRange)range
+        suggestedActions:(NSArray<UIMenuElement *> *)suggestedActions API_AVAILABLE(ios(16.0))
+{
+  if (_menuActionLabel.length == 0 || range.length == 0) {
+    return [UIMenu menuWithChildren:suggestedActions];
+  }
+  __weak RNUITextView *weakSelf = self;
+  UIAction *customAction = [UIAction actionWithTitle:_menuActionLabel
+                                               image:nil
+                                          identifier:nil
+                                             handler:^(__kindof UIAction *action) {
+    RNUITextView *strongSelf = weakSelf;
+    if (strongSelf == nil || strongSelf->_eventEmitter == nullptr) {
+      return;
+    }
+    std::dynamic_pointer_cast<const facebook::react::RNUITextViewEventEmitter>(strongSelf->_eventEmitter)
+      ->onMenuAction(facebook::react::RNUITextViewEventEmitter::OnMenuAction{
+        static_cast<int>(strongSelf.tag),
+        static_cast<int>(range.location),
+        static_cast<int>(range.location + range.length),
+      });
+    // Clear the selection once the action is consumed; defer past menu dismissal
+    // so the system teardown never races a live selection mutation.
+    UITextView *innerTextView = strongSelf->_textView;
+    dispatch_async(dispatch_get_main_queue(), ^{
+      innerTextView.selectedTextRange = nil;
+    });
+  }];
+  NSMutableArray<UIMenuElement *> *children = [NSMutableArray arrayWithObject:customAction];
+  [children addObjectsFromArray:suggestedActions];
+  return [UIMenu menuWithChildren:children];
