   private class ScrollViewHook : NativeViewGestureHandlerHook {
+    private var hasInterceptedTouchStream = false
+
     override fun shouldCancelRootViewGestureHandlerIfNecessary() = true
+
+    fun onIntercept() {
+      hasInterceptedTouchStream = true
+    }
+
+    override fun sendTouchEvent(view: View?, event: MotionEvent): Boolean? {
+      // Early/forced activation does not imply that the ScrollView intercepted.
+      // Keep its original delivery path until onInterceptTouchEvent returns true.
+      if (!hasInterceptedTouchStream) return view?.onTouchEvent(event)
+
+      // Interception bypasses root dispatch. Let the ScrollView cancel its child
+      // touch target, or text can run a pending long-press after UP (Cindy #6219).
+      val handled = view?.dispatchTouchEvent(event)
+      if (event.actionMasked == MotionEvent.ACTION_UP || event.actionMasked == MotionEvent.ACTION_CANCEL) {
+        hasInterceptedTouchStream = false
+      }
+      return handled
+    }
   }
 
