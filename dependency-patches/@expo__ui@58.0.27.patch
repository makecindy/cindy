diff --git a/ios/FormView.swift b/ios/FormView.swift
index aadb0c9b56c8f8b5d9f05a233497b3739408c5e3..afb4639349131bcef9bdc34901f8c9a837f42465 100644
--- a/ios/FormView.swift
+++ b/ios/FormView.swift
@@ -4,14 +4,30 @@ import SwiftUI
 import ExpoModulesCore
 
 internal final class FormViewProps: UIBaseViewProps {
+  @Field var initialScrollTargetId: String?
 }
 
 internal struct FormView: ExpoSwiftUI.View {
   @ObservedObject var props: FormViewProps
+  @State private var didScrollToInitialTarget = false
 
   var body: some View {
-    Form {
-      Children()
+    ScrollViewReader { proxy in
+      Form {
+        Children()
+      }
+      .onAppear { scrollToInitialTarget(proxy) }
+      .onChange(of: props.initialScrollTargetId) { _ in scrollToInitialTarget(proxy) }
+      .onDisappear { didScrollToInitialTarget = false }
+    }
+  }
+
+  private func scrollToInitialTarget(_ proxy: ScrollViewProxy) {
+    guard !didScrollToInitialTarget, let target = props.initialScrollTargetId else { return }
+    didScrollToInitialTarget = true
+    // Wait until newly supplied children have joined the Form's layout.
+    DispatchQueue.main.async {
+      proxy.scrollTo(target, anchor: .center)
     }
   }
 }
