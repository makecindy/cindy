{
  "id": "cindy-production-pi",
  "version": 1,
  "agentBackend": "pi",
  "agentBinaryPath": "/opt/cindy-headless/bin/pi/pi",
  "agentBinaryVersion": "1.4.0",
  "supportedModelIds": ["claude-sonnet-4-6"],
  "model": {
    "provider": "cindy",
    "requestedId": "claude-sonnet-4-6",
    "routeId": "configured-proxy",
    "contextLimit": 200000,
    "maxOutputTokens": 32000,
    "effort": "high"
  },
  "permissionMode": "bypassPermissions",
  "systemPromptFile": "prompt.md",
  "expectedSystemPromptDigest": "8c30f6d0acb69279f7cfaa172366c0f9071f70dd80f4c3de1a32cdd9d2e20772",
  "makerMemory": true,
  "nativeMemory": false,
  "projectContext": true,
  "containerSandbox": true,
  "inputPolicy": {
    "attachments": true,
    "workspaceOnly": true,
    "maxFiles": 16,
    "maxFileBytes": 26214400
  },
  "mcpServers": [],
  "piProjectSkills": {
    "enabled": true,
    "roots": [".pi/skills", ".agents/skills"]
  },
  "compaction": {
    "enabled": true,
    "thresholdPct": 80
  }
}
