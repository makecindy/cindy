{
  "id": "cindy-production-pi",
  "version": 1,
  "agentBackend": "pi",
  "agentBinaryPath": "/opt/cindy-headless/bin/pi/pi",
  "agentBinaryVersion": "1.5.2",
  "supportedModelIds": ["claude-sonnet-4-6"],
  "model": {
    "provider": "cindy",
    "requestedId": "claude-sonnet-4-6",
    "routeId": "configured-proxy",
    "contextLimit": 200000,
    "maxOutputTokens": 32000,
    "effort": "high"
  },
  "permissionMode": "bypassPermissions",
  "systemPromptFile": "prompt.md",
  "expectedSystemPromptDigest": "dd9fa6076ff2e9340d7e38a37d15b29e55297f6f87c0f4fed3fccbd8d40bdb24",
  "makerMemory": true,
  "nativeMemory": false,
  "projectContext": true,
  "containerSandbox": true,
  "inputPolicy": {
    "attachments": true,
    "workspaceOnly": true,
    "maxFiles": 16,
    "maxFileBytes": 26214400
  },
  "mcpServers": [],
  "piProjectSkills": {
    "enabled": true,
    "roots": [
      ".pi/skills",
      ".agents/skills"
    ]
  },
  "compaction": {
    "enabled": true,
    "thresholdPct": 80
  }
}
