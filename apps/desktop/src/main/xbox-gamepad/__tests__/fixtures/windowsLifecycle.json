          "expect": {
            "present": true,
            "name": "Xbox 测试 A",
            "voiceHeld": true,
            "scrollHeld": true,
            "releases": 0
          }
        },
        {
          "kind": "snapshot",
          "devices": [
            {
              "handle": "b",
              "id": "b",
              "name": "Xbox 测试 B",
              "metadataOk": true
