  "scenarios": [
    {
      "name": "metadata failures preserve held input and same-family selection until physical removal",
      "steps": [
        {
          "kind": "snapshot",
          "devices": [
            {
              "handle": "a",
              "id": "a",
              "name": "Xbox 测试 A",
              "metadataOk": true
            }
          ],
          "messages": [
            {
              "kind": "presence",
              "family": "xbox",
              "present": true,
              "name": "Xbox 测试 A",
              "category": "Windows.Gaming.Input",
              "transport": "unknown"
            }
          ],
          "expect": {
            "present": true,
            "name": "Xbox 测试 A",
            "voiceHeld": false,
            "scrollHeld": false,
            "releases": 0
          }
        },
        {
          "kind": "frame",
          "frame": "neutral",
          "messages": ["neutral"],
          "expect": {
            "present": true,
            "name": "Xbox 测试 A",
            "voiceHeld": false,
            "scrollHeld": false,
            "releases": 0
          }
        },
        {
          "kind": "frame",
          "frame": "held",
          "messages": ["held"],
          "expect": {
            "present": true,
            "name": "Xbox 测试 A",
            "voiceHeld": true,
            "scrollHeld": true,
            "releases": 0
          }
        },
        {
          "kind": "snapshot",
          "devices": [
            {
              "handle": "b",
              "id": "b",
              "name": "Xbox 测试 B",
              "metadataOk": true
            },
            {
              "handle": "a",
              "id": "a",
              "name": "Xbox 测试 A",
              "metadataOk": false
            }
          ],
          "repeat": 3,
          "messages": [],
          "expect": {
            "present": true,
            "name": "Xbox 测试 A",
            "voiceHeld": true,
            "scrollHeld": true,
            "releases": 0
          }
        },
        {
          "kind": "snapshot",
          "devices": [
            {
              "handle": "b",
              "id": "b",
              "name": "Xbox 测试 B",
              "metadataOk": true
            },
            {
              "handle": "a",
              "id": "a",
              "name": "Xbox 测试 A",
              "metadataOk": false
            }
          ],
          "force": true,
          "messages": [
            {
              "kind": "presence",
              "family": "xbox",
              "present": true,
              "name": "Xbox 测试 A",
              "category": "Windows.Gaming.Input",
              "transport": "unknown"
            }
          ],
          "expect": {
            "present": true,
            "name": "Xbox 测试 A",
            "voiceHeld": true,
            "scrollHeld": true,
            "releases": 0
          }
        },
        {
          "kind": "snapshot",
          "devices": [],
          "messages": [
            {
              "kind": "presence",
              "family": "xbox",
              "present": false
            }
          ],
          "expect": {
            "present": false,
            "name": null,
            "voiceHeld": false,
            "scrollHeld": false,
            "releases": 1
          }
        },
        {
          "kind": "snapshot",
          "devices": [],
          "messages": [],
          "expect": {
            "present": false,
            "name": null,
            "voiceHeld": false,
            "scrollHeld": false,
            "releases": 1
          }
        }
      ]
    },
    {
      "name": "reading failure releases voice and scroll once",
      "steps": [
        {
          "kind": "snapshot",
          "devices": [
            {
              "handle": "a",
              "id": "a",
              "name": "Xbox 测试 A",
              "metadataOk": true
            }
          ],
          "messages": [
            {
              "kind": "presence",
              "family": "xbox",
              "present": true,
              "name": "Xbox 测试 A",
              "category": "Windows.Gaming.Input",
              "transport": "unknown"
            }
          ],
          "expect": {
            "present": true,
            "name": "Xbox 测试 A",
            "voiceHeld": false,
            "scrollHeld": false,
            "releases": 0
          }
        },
        {
          "kind": "frame",
          "frame": "neutral",
          "messages": ["neutral"],
          "expect": {
            "present": true,
            "name": "Xbox 测试 A",
            "voiceHeld": false,
            "scrollHeld": false,
            "releases": 0
