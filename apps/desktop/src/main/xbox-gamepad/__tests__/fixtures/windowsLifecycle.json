          ],
          "expect": {
            "present": true,
            "name": "Xbox 测试 B",
            "voiceHeld": false,
            "scrollHeld": false,
            "releases": 1
          }
        },
        {
          "kind": "frame",
          "frame": "neutral",
          "messages": ["neutral"],
          "expect": {
            "present": true,
            "name": "Xbox 测试 B",
            "voiceHeld": false,
            "scrollHeld": false,
            "releases": 1
