          "expect": {
            "present": true,
            "name": "Xbox 测试 A",
            "voiceHeld": true,
            "scrollHeld": true,
            "releases": 0
          }
        },
        {
          "kind": "read-error",
          "messages": [
            {
              "kind": "presence",
              "family": "xbox",
              "present": false
            }
          ],
          "expect": {
            "present": false,
            "name": null,
            "voiceHeld": false,
            "scrollHeld": false,
            "releases": 1
          }
        },
        {
          "kind": "snapshot",
          "devices": [],
          "messages": [],
          "expect": {
            "present": false,
            "name": null,
            "voiceHeld": false,
            "scrollHeld": false,
            "releases": 1
          }
        }
      ]
    },
    {
      "name": "real replacement releases old holds before the new same-family device is exposed",
      "steps": [
        {
          "kind": "snapshot",
          "devices": [
            {
              "handle": "a",
              "id": "a",
              "name": "Xbox 测试 A",
              "metadataOk": true
            }
          ],
          "messages": [
            {
              "kind": "presence",
              "family": "xbox",
              "present": true,
              "name": "Xbox 测试 A",
              "category": "Windows.Gaming.Input",
              "transport": "unknown"
            }
          ],
          "expect": {
            "present": true,
            "name": "Xbox 测试 A",
            "voiceHeld": false,
            "scrollHeld": false,
            "releases": 0
          }
