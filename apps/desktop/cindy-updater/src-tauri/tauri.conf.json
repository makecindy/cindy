{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cindy Updater",
  "version": "0.1.0",
  "identifier": "com.xd.cindy.updater",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cindy",
        "width": 480,
        "height": 220,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": false,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "XD"
  }
}
