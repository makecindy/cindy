{
  "schemaVersion": 3,
  "id": "structured-records",
  "name": "结构化记录示例",
  "version": "1.0.0",
  "minCindyVersion": "0.1.122-beta",
  "entry": "main.js",
  "command": "structured-records",
  "whenToUse": "需要整理或比较多条记录时使用",
  "tools": [
    {
      "name": "open_view",
      "description": "整理或比较多条记录时默认打开此页面。只传结构化数据，由包内页面统一展示；不需要生成 HTML。",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "required": [
                "name",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "rows"
        ],
        "additionalProperties": false
      }
    }
  ],
  "mcpApps": {
    "ui": {
      "resources": [
        {
          "uri": "ui://structured-records/v1",
          "file": "ui/page.html",
          "prefersBorder": true
        }
      ],
      "tools": {
        "open_view": {
          "resourceUri": "ui://structured-records/v1",
          "visibility": [
            "model"
          ]
        }
      }
    }
  }
}
