{
  "schemaVersion": 3,
  "id": "interactive-shell",
  "name": "通用外壳示例",
  "version": "1.0.0",
  "minCindyVersion": "0.1.122-beta",
  "entry": "main.js",
  "command": "interactive-shell",
  "whenToUse": "按意图打开动态概览、统计或查询页面，演示通用外壳与后端生成界面",
  "tools": [
    {
      "name": "open_view",
      "description": "根据意图打开页面。页面内容只交给交互卡片，模型得到一句摘要。",
      "parameters": {
        "type": "object",
        "properties": {
          "intent": {
            "type": "string"
          }
        },
        "required": [
          "intent"
        ]
      }
    },
    {
      "name": "load_view",
      "description": "页面按声明的意图加载下一页或提交文本表单。",
      "parameters": {
        "type": "object",
        "properties": {
          "intent": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "required": [
          "intent"
        ]
      }
    }
  ],
  "mcpApps": {
    "ui": {
      "resources": [
        {
          "uri": "ui://shell/v1",
          "file": "ui/page.html",
          "prefersBorder": true
        }
      ],
      "tools": {
        "open_view": {
          "resourceUri": "ui://shell/v1",
          "visibility": [
            "model",
            "app"
          ]
        },
        "load_view": {
          "resourceUri": "ui://shell/v1",
          "visibility": [
            "app"
          ]
        }
      }
    }
  }
}
