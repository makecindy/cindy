#!/bin/sh
# Cindy 命令行启动器 —— 随 Cindy.app 分发,由「帮助 → 安装到命令行」symlink 到 PATH。
# 用法:  <命令名> [路径]   正式版命令名为 cindy(dev 构建为 cindydev),例如  cindy .
#
# 手动卸载:  rm 掉安装时创建的 symlink(默认 /usr/local/bin/<命令名>;命令名随
#            edition 品牌,正式版为 cindy,内部 dev 构建为 cindydev)。
#
# 自定位:先跟随 symlink 找到本脚本的真实路径,再按包内布局
#   <Cindy.app>/Contents/Resources/cli/cindy
# 反推 .app 根目录。因此即使 app 被移动位置,已装好的 symlink 仍然可用,无需重装
# (与 VS Code 的 bin/code 同一思路)。
PROG=$(basename "$0")
SELF="$0"

# 当命令通过 PATH 调用时，$0 可能不带路径（例如 "cindy"），需要先解析为可访问的路径。
case "$SELF" in
  */*) ;;
  *) SELF=$(command -v "$SELF" 2>/dev/null || printf '%s' "$SELF") ;;
esac

while [ -h "$SELF" ]; do
  link=$(readlink "$SELF")
  case "$link" in
    /*) SELF="$link" ;;
    *) SELF="$(dirname "$SELF")/$link" ;;
  esac
done
BIN_DIR=$(cd "$(dirname "$SELF")" >/dev/null 2>&1 && pwd)
APP=$(cd "$BIN_DIR/../../.." >/dev/null 2>&1 && pwd)

# 无参数:仅唤起 / 聚焦 app。
if [ "$#" -eq 0 ]; then
  exec open -a "$APP"
fi

# 只接受单个路径:app 冷启动时目录经 open-file → handleIncomingOpenFolder 落地,
# main 侧只有单个 pending 槽,窗口未就绪时多路径会互相覆盖、静默丢失。与其悄悄丢,
# 不如显式拒绝,让用户分多次调用。
if [ "$#" -gt 1 ]; then
  echo "$PROG: 一次只能打开一个路径(收到 $# 个)。请分多次运行,例如:$PROG ." >&2
  exit 2
fi

# 把参数解析成绝对路径(cindy . → 当前目录绝对路径),再交给 `open -a`;目录会通过
# app 的 open-file 管线落成工作目录。`--` 结束选项解析,避免以 - 开头的路径被 open
# 当成自身选项。
arg="$1"
if [ -d "$arg" ]; then
  abs=$(cd "$arg" >/dev/null 2>&1 && pwd)
elif [ -e "$arg" ]; then
  dir=$(cd "$(dirname "$arg")" >/dev/null 2>&1 && pwd) && abs="$dir/$(basename "$arg")"
else
  abs="$arg"
fi

exec open -a "$APP" -- "$abs"
