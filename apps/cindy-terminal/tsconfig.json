{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "noEmit": true, "isolatedModules": true,
    "jsx": "react-jsx", "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/local-runtime-acceptance.ts"]
}
