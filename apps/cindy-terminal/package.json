{
  "name": "cindy-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "cindy": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude **/*.integration.test.ts --maxWorkers=1 --fileParallelism=false",
    "test:integration": "vitest run src/host.integration.test.ts src/plugins/host.integration.test.ts src/models/runtime.integration.test.ts --testTimeout=30000 --maxWorkers=1 --fileParallelism=false"
  },
  "dependencies": {
    "@cindy/anthropic-compat-proxy": "workspace:*",
    "@cindy/anthropic-responses-bridge": "workspace:*",
    "@cindy/app-runtime": "workspace:*",
    "@cindy/auth-client": "workspace:*",
    "@cindy/browser-control-runtime": "workspace:*",
    "@cindy/companion-core": "workspace:*",
    "@cindy/device-link": "workspace:*",
    "@cindy/embedding-client": "workspace:*",
    "@cindy/file-browser-core": "workspace:*",
    "@cindy/im": "workspace:*",
    "@cindy/im-runtime": "workspace:*",
    "@cindy/maker-core": "workspace:*",
    "@cindy/maker-remote-ssh": "workspace:*",
    "@cindy/maker-scheduler": "workspace:*",
    "@cindy/maker-shared": "workspace:*",
    "@cindy/mcps": "workspace:*",
    "@cindy/media-core": "workspace:*",
    "@cindy/model-providers": "workspace:*",
    "@cindy/orca-workflow": "workspace:*",
    "@cindy/plugin-runtime": "workspace:*",
    "@cindy/remote-agent": "workspace:*",
    "@cindy/responses-anthropic-bridge": "workspace:*",
    "@cindy/responses-chat-bridge": "workspace:*",
    "@cindy/runtime-db": "workspace:*",
    "@cindy/terminal-core": "workspace:*",
    "@cindy/wechat-ilink": "workspace:*",
    "@cindy/worktree-core": "workspace:*",
    "@roamhq/wrtc": "0.10.0",
    "@napi-rs/canvas": "^0.1.100",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^4.0.3",
    "cindy-tools": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "ink": "7.0.0",
    "node-pty": "^1.0.0",
    "pdfjs-dist": "^5.7.284",
    "playwright-core": "1.60.0",
    "react": "19.2.3",
    "semver": "^7.8.5",
    "sharp": "^0.35.0",
    "silk-wasm": "^3.7.1",
    "ssh2": "^1.17.0",
    "tar": "^7.5.22",
    "trash": "10.1.1",
    "wrap-ansi": "8.1.0",
    "ws": "^8.18.3",
    "yauzl": "^2.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
