  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scope": "node scripts/mobile-scope-guard.mjs",
    "test:smoke": "vitest run src/__tests__/remoteControlSmoke.test.ts src/__tests__/mobileRemoteFlowSmoke.test.ts",
    "test:web-smoke": "node scripts/expo-web-smoke.mjs",
    "test:e2e:doctor": "node scripts/native-e2e-doctor.mjs",
    "test:e2e:doctor:ios": "node scripts/native-e2e-doctor.mjs --platform ios --require-maestro",
    "test:e2e:doctor:android": "node scripts/native-e2e-doctor.mjs --platform android --require-maestro",
    "test:e2e:maestro": "node scripts/maestro-e2e.mjs",
    "test:e2e:maestro:check": "node scripts/mobile-scope-guard.mjs && node scripts/maestro-flow-smoke.mjs",
    "test:e2e:create-session": "node scripts/maestro-e2e.mjs --flow create_session_smoke.yaml",
    "test:e2e:visual": "node scripts/maestro-e2e.mjs --flow visual_smoke.yaml --flow visual_session_idle.yaml --flow visual_session_running.yaml --flow visual_session_queue.yaml --flow visual_session_pending.yaml --flow visual_session_payload.yaml --flow visual_session_offline.yaml --flow visual_session_revoked.yaml",
    "test:e2e:visual:ios": "node scripts/local-device-link-smoke.mjs --mock-host --flow-suite visual --profile ios-iphone-17-pro-expo-go --api-base http://localhost:3333",
    "test:e2e:visual:android": "node scripts/local-device-link-smoke.mjs --mock-host --flow-suite visual --profile android-pixel-expo-go --api-base http://localhost:3333",
    "test:e2e:visual:baseline": "node scripts/visual-baseline-check.mjs",
    "test:e2e:visual:baseline:ios": "node scripts/visual-baseline-check.mjs --profile ios-iphone-17-pro-expo-go",
    "test:e2e:visual:baseline:android": "node scripts/visual-baseline-check.mjs --profile android-pixel-expo-go",
    "test:e2e:visual:update-baseline": "node scripts/visual-baseline-check.mjs --update",
    "test:e2e:visual:update-baseline:ios": "node scripts/visual-baseline-check.mjs --update --profile ios-iphone-17-pro-expo-go",
    "test:e2e:visual:update-baseline:android": "node scripts/visual-baseline-check.mjs --update --profile android-pixel-expo-go",
    "test:e2e:reconnect:local": "node scripts/device-link-reconnect-smoke.mjs --start-server",
    "test:e2e:local": "node scripts/local-device-link-smoke.mjs",
    "test:e2e:local:fixture": "node scripts/local-device-link-smoke.mjs --mock-host",
    "test:e2e:local:ios": "node scripts/local-device-link-smoke.mjs --start-server --start-expo --mock-host --profile ios-iphone-17-pro-expo-go --api-base http://localhost:3333",
    "test:e2e:local:real-db:ios": "node scripts/local-device-link-smoke.mjs --start-server --start-expo --mock-host --mock-host-real-db auto --profile ios-iphone-17-pro-expo-go --api-base http://localhost:3333",
    "test:e2e:local:create": "node scripts/local-device-link-smoke.mjs --mock-host --flow-suite create",
    "test:e2e:local:controls": "node scripts/local-device-link-smoke.mjs --mock-host --flow-suite controls",
    "test:e2e:local:voice": "node scripts/local-device-link-smoke.mjs --mock-host --flow-suite voice",
    "test:e2e:local:voice:ios": "node scripts/local-device-link-smoke.mjs --start-server --start-expo --mock-host --flow-suite voice --profile ios-iphone-17-pro-native --api-base http://localhost:3333",
    "test:voice-cloud:preflight": "node scripts/mobile-voice-cloud-preflight.mjs",
    "test:voice-cloud:preflight:run": "node scripts/mobile-voice-cloud-preflight.mjs --run",
    "test:e2e:local:file": "node scripts/local-device-link-smoke.mjs --mock-host --flow-suite file",
    "test:e2e:local:media": "node scripts/local-device-link-smoke.mjs --mock-host --flow-suite media",
    "test:e2e:local:visual": "node scripts/local-device-link-smoke.mjs --mock-host --flow-suite visual",
    "test:e2e:local:visual:revoked": "node scripts/local-device-link-smoke.mjs --mock-host --mock-host-scenario visual --mock-host-device-id mobile-e2e-host-revoked --flow visual_session_revoked.yaml",
    "test:e2e:local:visual:offline": "node scripts/local-device-link-smoke.mjs --mock-host --mock-host-scenario visual --mock-host-device-id mobile-e2e-host-offline --flow visual_session_offline.yaml",
    "test:e2e:local:full": "node scripts/local-device-link-smoke.mjs --mock-host --flow-suite full",
    "test:e2e:local:full:ios": "node scripts/local-device-link-smoke.mjs --start-server --start-expo --mock-host --flow-suite full --profile ios-iphone-17-pro-expo-go --api-base http://localhost:3333"
  },
  "private": true
}
