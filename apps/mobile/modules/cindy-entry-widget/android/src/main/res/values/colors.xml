<?xml version="1.0" encoding="utf-8"?>
<!-- 组件是 RemoteViews，读不到 Web / RN 的设计 token，所以色值只在这里定义一次：
     白天一份、夜间一份（values-night 只覆盖需要翻转的那几个），layout 与 drawable 一律
     引用名字，不再逐文件写死。 -->
<resources>
  <!-- 卡片底板：2×2 与 2×1 用，日夜各一套。 -->
  <color name="cindy_entry_widget_card">#F4F4F6</color>
  <color name="cindy_entry_widget_text">#1B1B1F</color>
  <color name="cindy_entry_widget_text_secondary">#8A8A8F</color>
  <!-- 1 格版式没有底板，名字直接落在壁纸上：跟启动器给原生图标画的名字一样固定白字 +
       阴影。故意不在 values-night 里覆盖 —— 旁边原生图标始终是白字，我们跟着主题变深就会
       显得不是一套东西。 -->
  <color name="cindy_entry_widget_icon_label">#FFFFFF</color>
  <color name="cindy_entry_widget_icon_label_shadow">#99000000</color>
</resources>
