<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    One home-screen widget per entry the user pins: the provider draws whatever target the
    widget's settings saved, and the settings page (APPWIDGET_CONFIGURE) lists the same targets
    the app handed over. Both merge in from this manifest, like the usage widgets.
  -->
  <application>
    <receiver
      android:name="app.cindy.entrywidget.EntryWidgetProvider"
      android:exported="true"
      android:label="@string/cindy_entry_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/cindy_entry_widget_info" />
    </receiver>
    <activity
      android:name="app.cindy.entrywidget.EntryConfigActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
      </intent-filter>
    </activity>
  </application>
</manifest>
