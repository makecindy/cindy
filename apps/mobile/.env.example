# ⚠️ 运行期业务端点不再走 .env(2026-07 端点清单重构):
#   - dev 初值来自仓内 config/endpoint.global.json(env.ts __DEV__ require);
#   - 生产由启动闸门从 <hotfix CDN>/endpoint.json 拉取回填;
#   - dev 想走线上 CDN 清单:EXPO_PUBLIC_ENDPOINTS_CDN=1(与 desktop --endpoints-cdn 同语义);
#   - 下面几个 base URL 仅在连本地 / staging 时显式覆写,不要复述生产域名。
# 清单自举基址由 ensure-mobile-env 从对应 region 的 config/endpoint*.json.cdnBaseUrl 补写。
EXPO_PUBLIC_CINDY_AUTH_REGION=global
EXPO_PUBLIC_ENDPOINT_MANIFEST_BASE_URL=
EXPO_PUBLIC_ENDPOINT_MANIFEST_PEER_BASE_URL=
EXPO_PUBLIC_CINDY_AUTH_BASE_URL=
EXPO_PUBLIC_XDT_DEVICE_LINK_API_BASE_URL=
# Global Google 原生登录(部署时由 EAS environment 注入;仓库不存 provider 凭证)
EXPO_PUBLIC_CINDY_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CINDY_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CINDY_GOOGLE_IOS_URL_SCHEME=
# CN WeChat 原生登录(部署时由 EAS environment 注入)
EXPO_PUBLIC_CINDY_WECHAT_APP_ID=
EXPO_PUBLIC_CINDY_WECHAT_UNIVERSAL_LINK=
# Dev / EAS TapDB 配置。自建线不读这里,改读 scripts/self-host-regions.json 的 tapdb 块。
EXPO_PUBLIC_TAPTAP_CLIENT_ID=
EXPO_PUBLIC_TAPTAP_CLIENT_TOKEN=
EXPO_PUBLIC_TAPDB_CHANNEL=
EXPO_PUBLIC_TAPDB_REGION=global
# Optional local e2e override. Production/TestFlight leaves this unset: the voice
# gateway base URL comes from the desktop-synced voice credential (proxyBaseUrl,
# issued by the model-access server); there is no client-side default anymore.
EXPO_PUBLIC_XDT_MOBILE_VOICE_LITELLM_BASE_URL=
# ── 以下变量由构建/发版流程注入(eas.json / scripts/release-*.mjs / sim-*.mjs),──
# ── 本地 .env 不需要手填,列在这里只为文档完整性: ──────────────────────────────
#   EXPO_PUBLIC_APP_VARIANT             构建变体标识(beta/prod/自建)
#   EXPO_PUBLIC_BETA_DEV                beta 开发模式门控
#   EXPO_PUBLIC_XDT_OTA_SELFHOST        是否自建变体(=1)
#   EXPO_PUBLIC_DESKTOP_VERSION         自建线配对的桌面产品线版本号
#   EXPO_PUBLIC_XDT_GIT_BRANCH          构建注入的 git 分支(调试展示)
#   EXPO_PUBLIC_XDT_GIT_COMMIT          构建注入的 git commit(调试展示)
#   EXPO_PUBLIC_XDT_MOBILE_E2E_MOCK_AUDIO  E2E 专用 mock 音频输入
#   CINDY_CN_APP_STORE_ID / CINDY_GLOBAL_APP_STORE_ID  对应 App Store 数字 ID(非 EXPO_PUBLIC)
#   EAS_OWNER / EAS_PROJECT_ID          EAS 账号归属 + 项目 id;仓库不写死,由发布环境注入
#                                       (app.config.js 读它注入 owner / extra.eas.projectId /
#                                        updates.url)。外部 fork 用自己的(eas init);官方值只
#                                        存在于 EAS environment / 自建发布脚本 env。缺省 = 不配 OTA。
