{
  "name": "@cindy/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "cindy-host": "./src/main.ts",
    "cindy-host-login": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --import tsx --import ./src/loaders/register-raw.mjs src/main.ts",
    "test": "node --import tsx --import ./src/loaders/register-raw.mjs --test \"src/**/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "test:lifecycle": "node scripts/lifecycle.e2e.mjs",
    "test:scheduler": "node --import tsx --import ./src/loaders/register-raw.mjs scripts/scheduler-runtime.e2e.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@cindy/anthropic-compat-proxy": "workspace:*",
    "@cindy/auth-client": "workspace:*",
    "@cindy/browser-control-runtime": "workspace:*",
    "@cindy/device-link": "workspace:*",
    "@cindy/maker-core": "workspace:*",
    "@cindy/maker-shared": "workspace:*",
    "@cindy/mcps": "workspace:*",
    "@cindy/model-providers": "workspace:*",
    "@cindy/plugin-protocol": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "cindy-tools": "workspace:*",
    "node-machine-id": "^1.1.12",
    "playwright-core": "1.63.0",
    "ws": "^8.18.0"
  }
}
